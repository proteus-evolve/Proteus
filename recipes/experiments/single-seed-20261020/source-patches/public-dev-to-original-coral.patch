+from proteus.examples.harbor_evaluation import IMAGE
+from proteus.execution.builds import SharedBuildLayer, SourceBuildSpec, build_key, dockerfile
+from test_v1_source_build import BUILDER, execute, fake_docker, services_fixture
+
+
+def shared():
+    return SharedBuildLayer(commands=('mkdir .deps && printf fixed > .deps/value',), outputs=('.deps',))
+
+
+@pytest.mark.parametrize('path', ['', '/', '../escape', 'a/../b', '.', 'a/./b', 'a//b',
+    'a\\b', 'a\nb', 'a b', 'a"b'])
+def test_shared_exports_reject_unsafe_paths(path):
+    with pytest.raises(ContractError):
+        SharedBuildLayer(commands=('true',), outputs=(path,))
+
+
+@pytest.mark.parametrize('paths', [('.deps', '.deps'), ('.deps', '.deps/subdir')])
+def test_shared_exports_reject_duplicate_or_overlapping_paths(paths):
+    with pytest.raises(ContractError):
+        SharedBuildLayer(commands=('true',), outputs=paths)
+
+
+@pytest.mark.parametrize('commands', [(), ('',), ('   ',), ('true\0false',)])
+def test_shared_commands_are_nonempty(commands):
+    with pytest.raises(ContractError):
+        SharedBuildLayer(commands=commands, outputs=('.deps',))
+
+
+def test_default_dockerfile_is_unchanged_and_shared_stage_precedes_source():
+    spec = SourceBuildSpec(commands=('true',))
+    assert dockerfile(spec, IMAGE) == (
+        f'FROM {IMAGE} AS candidate_build\nWORKDIR /opt/proteus/build\n'
+        'COPY source/ /opt/proteus/build/\n'
+        'RUN ["/bin/sh", "-eu", "-c", "true"]\n'
+        f'FROM {IMAGE}\nCOPY --from=candidate_build /opt/proteus/build/ /opt/proteus/build/\n'
+        'COPY source/ /opt/proteus/source/\nWORKDIR /opt/proteus/build\n')
+    definition = dockerfile(replace(spec, shared_layer=shared()), IMAGE)
+    before_source, _ = definition.split(' AS candidate_build\n', 1)
+    assert 'COPY source' not in before_source
+    assert 'shared_dependencies' in before_source
+    runtime = definition.split(f'FROM {IMAGE}\n', 1)[1]
+    assert runtime.index('COPY --from=shared_dependencies') < runtime.index('COPY --from=candidate_build')
+    assert json.dumps(['/opt/proteus/shared/.deps', '/opt/proteus/build/.deps']) in runtime
+    assert '/tests' not in definition
+
+
+def test_shared_definition_and_candidate_bytes_are_both_content_bound(tmp_path):
+    services, candidate, original = services_fixture(tmp_path)
+    spec = replace(original, shared_layer=shared())
+    key = build_key(candidate.artifact, spec, IMAGE, BUILDER)
+    for layer in (replace(shared(), commands=('printf changed',)), replace(shared(), outputs=('.other',))):
+        assert build_key(candidate.artifact, replace(spec, shared_layer=layer), IMAGE, BUILDER) != key
+    delta = FileDelta(base_hash=candidate.artifact.content_hash,
+        put=(FileWrite.from_bytes('new.py', b'pass\n'),))
+    changed = services.artifacts.apply_delta(candidate.artifact, delta)
+    assert build_key(changed, spec, IMAGE, BUILDER) != key
+    assert SourceBuildSpec.from_json(spec.to_json()) == spec
+
+
+@pytest.mark.parametrize('path', ['.deps', '.deps/poison.py', 'parent'])
+def test_candidate_cannot_shadow_shared_layer_and_never_builds(tmp_path, monkeypatch, path):
+    services, candidate, original = services_fixture(tmp_path)
+    layer = replace(shared(), outputs=('parent/deps',)) if path == 'parent' else shared()
+    spec = replace(original, shared_layer=layer)
+    services.recipe = replace(services.recipe, execution=replace(services.recipe.execution,
+        environment=replace(services.recipe.execution.environment, build_hash=content_hash(spec))))
+    _, commands = fake_docker(monkeypatch)
+    delta = FileDelta(base_hash=candidate.artifact.content_hash,
+        put=(FileWrite.from_bytes(path, b'not a dependency\n'),))
+    changed = services.fork_candidate(candidate, delta=delta, candidate_id='shadow')
+    with pytest.raises(InvalidCandidate, match='overlaps'):
+        execute(services, changed, spec, 'shadow')
+    assert commands == []
+    receipt = services.builds.records[-1]
+    assert receipt.status == 'failed' and receipt.image_id is None
+    assert receipt.usage.model_calls == 0
+
+
+def test_coral_keeps_same_pinned_dependencies_and_runtime_location():
+    spec = build_spec()
+    assert spec.shared_layer.outputs == ('.proteus-deps',)
+    assert spec.commands == ('true',)
+    assert '--require-hashes --only-binary=:all:' in spec.shared_layer.commands[1]
+    assert '--target /opt/proteus/shared/.proteus-deps' in spec.shared_layer.commands[1]
+    assert spec.timeout_seconds == 900 and spec.platform == 'linux/amd64'
+    assert spec.network == 'default'
+
