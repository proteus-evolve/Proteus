+"""Fixed dependency layers do not contain or shadow mutable candidate code."""
+
+from dataclasses import replace
+import json
+
+import pytest
+
+from proteus.artifacts.codecs import FileDelta, FileWrite
+from proteus.benchmarks.coral_circle_packing.recipe import build_spec
