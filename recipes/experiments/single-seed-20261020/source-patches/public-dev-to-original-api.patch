diff --git a/proteus/core/snapshot_store.py b/proteus/core/snapshot_store.py
new file mode 100644
index 0000000..4a87362
--- /dev/null
+++ b/proteus/core/snapshot_store.py
@@ -0,0 +1,153 @@
+"""Lossless, hash-checked snapshot DAG for experimental large recovery journals.
+
+Only storage changes: snapshots decode to detached ordinary JSON, and the journal
+still verifies the original full-value digest. SQLite commits all referenced
+nodes before a journal envelope is published. Unreferenced crash-time nodes are
+harmless; no garbage collection or historical-run conversion occurs here.
+"""
+from __future__ import annotations
+
+import hashlib
+from contextlib import contextmanager
+import json
+from pathlib import Path
+import re
+import sqlite3
+import zlib
+
+from proteus.core.serialization import ContractError, json_value
+
+FORMAT = "proteus.snapshot_dag.v1"
+PAGE = 64
+INLINE = 768
+_KNOWN = {}
+
+
+def directory(path: Path) -> Path:
+    return path.parent.parent if path.parent.name == "operations" else path.parent
+
+
+def _bytes(value):
+    return json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode()
+
+
+@contextmanager
+def _connect(root, *, readonly):
+    root = Path(root).absolute()
+    path = root / "snapshot-nodes.sqlite3"
+    if path.is_symlink() or (root.exists() and root.is_symlink()):
+        raise ContractError("snapshot store must not be a symlink")
+    if readonly:
+        if not path.is_file():
+            raise ContractError("snapshot node store is missing")
+        db = sqlite3.connect(path.as_uri()+"?mode=ro", uri=True, timeout=30)
+    else:
+        root.mkdir(parents=True, exist_ok=True)
+        db = sqlite3.connect(path, timeout=30)
+    try:
+        if not readonly:
+            db.execute("PRAGMA synchronous=FULL")
+            db.execute("CREATE TABLE IF NOT EXISTS nodes (hash TEXT PRIMARY KEY, data BLOB NOT NULL)")
+        with db:
+            yield db
+    finally:
+        # sqlite's own context manager commits/rolls back but never closes.
+        db.close()
+
+
+def encode(root: Path, snapshot):
+    snapshot = json_value(snapshot)
+    path=Path(root).absolute()/"snapshot-nodes.sqlite3"
+    created=set()
+    with _connect(root, readonly=False) as db:
+        info=path.stat()
+        cache_key=(str(path),info.st_dev,info.st_ino)
+        if len(_KNOWN)>16:
+            _KNOWN.clear()
+        known=_KNOWN.setdefault(cache_key,set())
+        db.execute("BEGIN IMMEDIATE")
+        def node(encoded):
+            raw = _bytes(encoded)
+            if len(raw) < INLINE:
+                return encoded
+            digest = hashlib.sha256(raw).hexdigest()
+            if digest not in known and digest not in created:
+                db.execute("INSERT OR IGNORE INTO nodes(hash,data) VALUES(?,?)", (digest, zlib.compress(raw, 3)))
+                created.add(digest)
+            return ["@", digest]
+
+        def pack(value):
+            if isinstance(value, dict):
+                return node(["d", [[key, pack(value[key])] for key in sorted(value)]])
+            if isinstance(value, list):
+                if len(value) > PAGE:
+                    return node(["a", [pack(value[start:start+PAGE]) for start in range(0,len(value),PAGE)]])
+                return node(["l", [pack(item) for item in value]])
+            if isinstance(value, str) and len(value) >= INLINE:
+                return node(["s", value])
+            return value
+        encoded = pack(snapshot)
+    # Never cache nodes from a rolled-back transaction.
+    known.update(created)
+    if len(known)>300000:
+        known.clear()
+    return encoded
+
+
+def decode(root: Path, encoded):
+    active = set()
+    cache = {}
+    with _connect(root, readonly=True) as db:
+        def unpack(value, depth=0):
+            if depth > 256:
+                raise ContractError("snapshot node nesting limit exceeded")
+            if not isinstance(value, list):
+                if type(value) not in (str,int,float,bool,type(None)):
+                    raise ContractError("invalid inline snapshot node")
+                return value
+            if len(value) != 2 or value[0] not in ("@","d","l","a","s"):
+                raise ContractError("invalid snapshot node encoding")
+            kind, payload = value
+            if kind == "@":
+                if type(payload) is not str or not re.fullmatch(r"[0-9a-f]{64}",payload) or payload in active:
+                    raise ContractError("invalid or cyclic snapshot reference")
+                if payload not in cache:
+                    row = db.execute("SELECT data FROM nodes WHERE hash=?",(payload,)).fetchone()
+                    if row is None:
+                        raise ContractError("snapshot node is missing")
+                    try:
+                        raw = zlib.decompress(row[0])
+                        if hashlib.sha256(raw).hexdigest() != payload:
+                            raise ContractError("snapshot node integrity mismatch")
+                        cache[payload] = json.loads(raw)
+                    except (zlib.error,ValueError) as exc:
+                        raise ContractError("invalid compressed snapshot node") from exc
+                active.add(payload)
+                try:
+                    # Cache encoded nodes only: repeated references must decode
+                    # to fresh mutable containers, never alias restored state.
+                    return unpack(cache[payload],depth+1)
+                finally:
+                    active.remove(payload)
+            if kind == "s":
+                if type(payload) is not str:
+                    raise ContractError("invalid snapshot string")
+                return payload
+            if kind == "d":
+                if not isinstance(payload,list):
+                    raise ContractError("invalid snapshot dictionary")
+                result = {}
+                for pair in payload:
+                    if not isinstance(pair,list) or len(pair)!=2 or type(pair[0]) is not str or pair[0] in result:
+                        raise ContractError("invalid snapshot dictionary entry")
+                    result[pair[0]] = unpack(pair[1],depth+1)
+                return result
+            if not isinstance(payload,list):
+                raise ContractError("invalid snapshot sequence")
+            items = [unpack(item,depth+1) for item in payload]
+            if kind == "l":
+                return items
+            if not all(isinstance(item,list) for item in items):
+                raise ContractError("invalid snapshot page")
+            return [item for page in items for item in page]
+        return unpack(encoded)
