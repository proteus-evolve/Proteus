diff --git a/proteus/execution/docker_local_api.py b/proteus/execution/docker_local_api.py
new file mode 100644
index 0000000..0848851
--- /dev/null
+++ b/proteus/execution/docker_local_api.py
@@ -0,0 +1,157 @@
+"""Optional pinned local-Unix Docker metadata/owned-cleanup transport.
+
+Candidate execution still uses Harbor. This module never forwards environment,
+Docker auth, remote TCP endpoints, or arbitrary delete requests.
+"""
+from __future__ import annotations
+
+import http.client
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import stat
+import subprocess
+import time
+from urllib.parse import quote, urlencode
+
+
+class UnixConnection(http.client.HTTPConnection):
+    def __init__(self, path, timeout):
+        super().__init__('localhost', timeout=timeout)
+        self.path = path
+
+    def connect(self):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.settimeout(self.timeout)
+        self.sock.connect(self.path)
+
+
+def validate_options(options):
+    """Validate the opt-in pin without connecting or changing Docker context."""
+    if not options:
+        return
+    if set(options) != {'socket', 'daemon_id', 'version'} or options['version'] != '1.41':
+        raise ValueError('local Docker API needs explicit socket, daemon_id and version1.41 pins')
+    if not all(isinstance(v, str) and v for v in options.values()) or not Path(options['socket']).is_absolute():
+        raise ValueError('invalid local Docker API pin')
+
+
+def compatible_context(options):
+    """Other/remote contexts retain the original CLI path, never guessed sockets."""
+    validate_options(options)
+    if not options:
+        return False
+    if os.environ.get('DOCKER_CONTEXT', 'default') not in ('', 'default'):
+        return False
+    host = os.environ.get('DOCKER_HOST')
+    if host and host != 'unix://' + options['socket']:
+        return False
+    config = Path(os.environ.get('DOCKER_CONFIG', str(Path.home()/'.docker'))) / 'config.json'
+    if config.exists() and json.loads(config.read_text()).get('currentContext', 'default') not in ('', 'default'):
+        return False
+    if not stat.S_ISSOCK(Path(options['socket']).stat().st_mode):
+        raise ValueError('local Docker API pin does not identify a Unix socket')
+    return True
+
+
+class LocalDockerAPI:
+    def __init__(self, options, *, timeout=30):
+        self.options = dict(options)
+        info = self.request('GET', '/info', timeout=timeout)
+        if info.get('ID') != options['daemon_id']:
+            raise ValueError('local Docker daemon differs from its explicit identity pin')
+
+    def request(self, method, path, *, timeout, missing=False):
+        if timeout <= 0:
+            raise TimeoutError('local Docker API deadline exceeded')
+        connection = UnixConnection(self.options['socket'], timeout)
+        try:
+            connection.request(method, '/v'+self.options['version']+path)
+            response = connection.getresponse()
+            data = response.read(8*1024*1024+1)
+            if len(data) > 8*1024*1024:
+                raise ValueError('Docker metadata exceeds transport bound')
+            if response.status == 404 and missing:
+                return None
+            if response.status not in (200, 201, 204):
+                # Arbitrary daemon messages can include command/environment data.
+                raise RuntimeError(f'Docker API {method} failed with status{response.status}')
+            return json.loads(data) if data else None
+        finally:
+            connection.close()
+
+    def listing(self, kind, project, timeout):
+        filters = json.dumps({'label': ['com.docker.compose.project='+project]}, separators=(',', ':'))
+        query = urlencode({'filters': filters, **({'all': '1'} if kind == 'container' else {})})
+        result = self.request('GET', '/'+{'container':'containers/json','network':'networks','volume':'volumes'}[kind]
+                              +'?'+query, timeout=timeout)
+        return (result.get('Volumes') or []) if kind == 'volume' else result
+
+    def cleanup(self, trial_name, timeout):
+        if re.fullmatch(r'proteus-[0-9a-f]{32}', trial_name) is None:
+            raise ValueError('invalid owned trial name')
+        deadline = time.monotonic()+timeout
+        records, errors = [], []
+        def remaining():
+            return min(30, max(0, deadline-time.monotonic()))
+        for project in (trial_name+'__env', trial_name+'__verifier__trial'):
+            for kind in ('container', 'network', 'volume'):
+                removed, already_absent = [], []
+                try:
+                    rows = self.listing(kind, project, remaining())
+                    for row in rows:
+                        identity = row['Name'] if kind == 'volume' else row['Id']
+                        path = '/'+{'container':'containers','network':'networks','volume':'volumes'}[kind]+'/'+quote(identity, safe='')
+                        fresh = self.request('GET', path+('/json' if kind == 'container' else ''), timeout=remaining(), missing=True)
+                        if fresh is None:
+                            already_absent.append(identity)
+                            continue
+                        labels = (fresh.get('Config') or {}).get('Labels') if kind == 'container' else fresh.get('Labels')
+                        if not labels or labels.get('com.docker.compose.project') != project:
+                            raise ValueError('owned resource label changed before deletion')
+                        self.request('DELETE', path+('?force=1&v=1' if kind == 'container' else ''),
+                                     timeout=remaining(), missing=True)
+                        removed.append(identity)
+                    after = self.listing(kind, project, remaining())
+                    records.append({'project':project,'kind':kind,'removed':removed,'already_absent':already_absent,
+                        'remaining':[r['Name'] if kind == 'volume' else r['Id'] for r in after]})
+                except Exception as exc:
+                    errors.append({'project':project,'kind':kind,'error':type(exc).__name__})
+        return {'verified':not errors and all(not r['remaining'] for r in records),
+                'resources':records,'errors':errors,'transport':'pinned_local_unix_docker_api'}
+
+    def command(self, args, timeout):
+        """Only recognized read-only CLI spellings use this fast path."""
+        if args and args[0] == 'inspect' and len(args) == 2:
+            row = self.request('GET', '/containers/'+quote(args[1], safe='')+'/json', timeout=timeout)
+            return json.dumps([row])
+        if args[:2] == ('image', 'inspect') and len(args) == 3:
+            row = self.request('GET', '/images/'+quote(args[2], safe='')+'/json', timeout=timeout, missing=True)
+            if row is None:
+                raise subprocess.CalledProcessError(1, ['docker', *args], stderr='No such image: '+args[2])
+            return json.dumps([row])
+        if args and args[0] == 'ps' and args[-2:] == ('--format', '{{.ID}}'):
+            # Only the exact project/service metadata spelling used by the
+            # bridge is supported; no broad arbitrary Docker command forwarding.
+            filters = []
+            index = 1
+            while index < len(args)-2:
+                arg = args[index]
+                if arg == '--filter' and index+1 < len(args)-2:
+                    value = args[index+1]
+                    if not value.startswith('label='):
+                        return NotImplemented
+                    filters.append(value.removeprefix('label='))
+                    index += 2
+                elif arg == '--all':
+                    index += 1
+                else:
+                    return NotImplemented
+            if not filters:
+                return NotImplemented
+            query = urlencode({'all':'1','filters':json.dumps({'label':filters}, separators=(',', ':'))})
+            rows = self.request('GET', '/containers/json?'+query, timeout=timeout)
+            return '\n'.join(row['Id'][:12] for row in rows)
+        return NotImplemented
