+import json
+import random
+import sqlite3
+import string
+
+import pytest
+
+from proteus.core.recovery import _write,_load
+from proteus.core.serialization import ContractError,content_hash
+from proteus.core.snapshot_store import encode,decode
+
+
+def test_roundtrip_detached_and_legacy(tmp_path):
+    original={'rows':[{'text':'["@","literal"]'+'中文'*1000}]*90,'flags':[True,None,3,1.25],
+              'reserved':['@','d','l','a','s']}
+    encoded=encode(tmp_path,original)
+    actual=decode(tmp_path,encoded)
+    assert actual==original and content_hash(actual)==content_hash(original)
+    actual['rows'][0]['text']='changed'
+    assert actual['rows'][1]['text']==original['rows'][1]['text']
+    old=tmp_path/'legacy.json'
+    _write(old,{'old':'no snapshot'})
+    assert _load(old)=={'old':'no snapshot'}
+    path=tmp_path/'operations/00000001.result.json'
+    value={'snapshot':original,'output':{'ok':True}}
+    _write(path,value)
+    assert _load(path)==value
+    assert json.loads(path.read_text())['storage']=='proteus.snapshot_dag.v1'
+
+
+def test_repeated_snapshots_share_nodes_and_keep_all_versions(tmp_path):
+    rng=random.Random(4)
+    rows=[]; naive=0
+    for n in range(90):
+        rows.append({'n':n,'text':''.join(rng.choices(string.ascii_letters,k=2000))})
+        value={'snapshot':{'rows':rows.copy(),'cursor':n}}
+        naive+=len(json.dumps(value))
+        path=tmp_path/'operations'/f'{n:08d}.result.json'
+        _write(path,value)
+        assert _load(path)==value
+    size=sum(p.stat().st_size for p in tmp_path.rglob('*') if p.is_file())
+    assert size < naive/5
+    assert len(_load(tmp_path/'operations/00000000.result.json')['snapshot']['rows'])==1
+    assert len(_load(tmp_path/'operations/00000089.result.json')['snapshot']['rows'])==90
+
+
+def test_missing_and_corrupt_nodes_fail_closed(tmp_path):
+    path=tmp_path/'operations/00000001.result.json'
+    value={'snapshot':{'large':'DATA'*2000}}
+    _write(path,value)
+    dbpath=tmp_path/'snapshot-nodes.sqlite3'
+    with sqlite3.connect(dbpath) as db:
+        db.execute('UPDATE nodes SET data=?',(b'invalid',))
+    with pytest.raises(ContractError): _load(path)
+    dbpath.rename(tmp_path/'retained-corrupt-store')
+    with pytest.raises(ContractError,match='missing'): _load(path)
+
+
+def test_orphan_nodes_do_not_publish_a_committed_operation(tmp_path):
+    encode(tmp_path,{'blob':'large'*2000})
+    assert not list(tmp_path.glob('operations/*.result.json'))
+    path=tmp_path/'operations/00000001.result.json'
+    _write(path,{'snapshot':{'blob':'different'*2000}})
+    assert _load(path)['snapshot']['blob']=='different'*2000
+
+
+def test_node_digest_verified(tmp_path):
+    encoded=encode(tmp_path,{'payload':'x'*5000})
+    with sqlite3.connect(tmp_path/'snapshot-nodes.sqlite3') as db:
+        assert all(len(row[0])==64 for row in db.execute('SELECT hash FROM nodes'))
+    assert decode(tmp_path,encoded)=={'payload':'x'*5000}
