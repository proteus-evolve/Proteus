index 0000000..d345392
--- /dev/null
+++ b/tests/test_v1_harbor_admission.py
@@ -0,0 +1,34 @@
+import threading
+import time
+
+import pytest
+
+from proteus.execution.harbor import admission_lease
+
+
+def test_optional_admission_does_not_serialize_by_default():
+    with admission_lease(None) as receipt:
+        assert receipt is None
+
+
+def test_admission_serializes_distinct_runs_and_releases_after_exception(tmp_path):
+    path = str(tmp_path/'container.lock')
+    acquired, finished = threading.Event(), threading.Event()
+    receipts = []
+    def second():
+        with admission_lease(path) as receipt:
+            receipts.append(receipt)
+            acquired.set()
+        finished.set()
+    with pytest.raises(RuntimeError, match='owned operation'):
+        with admission_lease(path):
+            thread = threading.Thread(target=second)
+            thread.start()
+            time.sleep(.05)
+            assert not acquired.is_set()
+            raise RuntimeError('owned operation failed')
+    assert acquired.wait(3) and finished.wait(3)
+    thread.join()
+    assert receipts[0]['wait_seconds'] >= .04
+    with admission_lease(path):
+        assert (tmp_path/'container.lock').exists()
