+import io
+import json
+from pathlib import Path
+import struct
+import tarfile
+import time
+
+import pytest
+
+from proteus.execution.docker_local_io import OwnedDockerIO, archive, multiplexed_output
+
+PROJECT='proteus-'+'a'*32+'__env'
+CONTAINER='b'*64
+EXEC='c'*64
+
+
+class API:
+    options={'socket':'/pinned/socket','daemon_id':'owned-daemon','version':'1.41'}
+    changed=False
+    def listing(self,*args):
+        return [{'Id':CONTAINER,'Labels':{'com.docker.compose.service':'main'}}]
+    def request(self,method,path,**kwargs):
+        if path=='/info':
+            return {'ID':'owned-daemon'}
+        return {'Id':CONTAINER,'Config':{'Labels':{'com.docker.compose.project':'foreign' if self.changed else PROJECT,
+            'com.docker.compose.service':'main'}},'Mounts':[],
+            'HostConfig':{'NetworkMode':'none','Privileged':False,'CapDrop':['ALL'],
+                         'SecurityOpt':['no-new-privileges:true']}}
+
+
+def frame(channel,value):
+    return bytes([channel,0,0,0])+struct.pack('>I',len(value))+value
+
+
+def test_multiplex_preserves_merged_binary_stream_order_and_bounds():
+    assert multiplexed_output(frame(1,b'out\n')+frame(2,b'err\xff\n'))==b'out\nerr\xff\n'
+    for invalid in (b'x',frame(0,b'x'),b'\1\0\0\0'+struct.pack('>I',100)+b'x'):
+        with pytest.raises(ValueError):
+            multiplexed_output(invalid)
+
+
+def test_upload_archive_is_binary_safe_and_preserves_executable_mode(tmp_path):
+    root=tmp_path/'candidate';root.mkdir()
+    (root/'binary').write_bytes(b'\0\xff\r\n')
+    executable=root/'run';executable.write_text('hello');executable.chmod(0o755)
+    (root/'link').symlink_to('binary')
+    data=archive(root,directory=True)
+    with tarfile.open(fileobj=io.BytesIO(data)) as stream:
+        assert stream.extractfile('./binary').read()==b'\0\xff\r\n'
+        assert stream.getmember('./run').mode & 0o111
+        assert stream.getmember('./link').issym()
+        assert all(row.uid==0 and row.gid==0 for row in stream.getmembers())
+
+
+def test_exec_preserves_user_cwd_env_and_exit_code():
+    client=OwnedDockerIO(API(),None,PROJECT)
+    requests=[]
+    def request(method,path,deadline,body=b'',content_type='application/json'):
+        requests.append((method,path,body))
+        if path=='/containers/'+CONTAINER+'/exec':
+            return json.dumps({'Id':EXEC}).encode()
+        if path.endswith('/start'):
+            return frame(1,b'out\n')+frame(2,b'err\n')
+        return b'{"Running":false,"ExitCode":7}'
+    client.request=request
+    result=client.execute(['bash','-c','exit 7'],deadline=time.monotonic()+10,
+                          cwd='/work',env={'X':'abc'},user=65534)
+    payload=json.loads(requests[0][2])
+    assert payload['Cmd']==['bash','-c','exit 7']
+    assert payload['WorkingDir']=='/work' and payload['Env']==['X=abc'] and payload['User']=='65534'
+    assert not payload['Tty'] and not payload['AttachStdin']
+    assert result=={'stdout':'out\nerr\n','stderr':None,'return_code':7}
+
+
+def test_fresh_label_mismatch_cannot_execute():
+    api=API();api.changed=True
+    client=OwnedDockerIO(api,None,PROJECT)
+    client.request=lambda *args,**kwargs:pytest.fail('must not dispatch on foreign resource')
+    with pytest.raises(ValueError,match='labels/isolation'):
+        client.execute(['true'],deadline=time.monotonic()+10)
+
+
+def test_changed_daemon_cannot_execute():
+    api=API();api.request=lambda *args,**kwargs:{'ID':'wrong-daemon'}
+    with pytest.raises(ValueError,match='daemon identity'):
+        OwnedDockerIO(api,None,PROJECT).execute(['true'],deadline=time.monotonic()+10)
+
+
+def test_running_exec_is_not_reported_as_success_and_is_not_retried():
+    client=OwnedDockerIO(API(),None,PROJECT);calls=[]
+    def request(method,path,deadline,body=b'',content_type='application/json'):
+        calls.append(path)
+        if path.endswith('/exec'):return json.dumps({'Id':EXEC}).encode()
+        if path.endswith('/start'):return b''
+        return b'{"Running":true,"ExitCode":0}'
+    client.request=request
+    with pytest.raises(ValueError,match='terminal exit'):
+        client.execute(['true'],deadline=time.monotonic()+10)
+    assert calls.count('/exec/'+EXEC+'/start')==1
+
+
+def test_expired_deadline_and_foreign_project_are_rejected_before_connection():
+    client=OwnedDockerIO(API(),None,PROJECT)
+    with pytest.raises(TimeoutError):
+        client.execute(['true'],deadline=time.monotonic()-1)
+    with pytest.raises(ValueError):
+        OwnedDockerIO(API(),None,'unrelated')
+
+
+def test_upload_does_not_accept_arbitrary_container_paths(tmp_path):
+    source=tmp_path/'x';source.write_text('x')
+    client=OwnedDockerIO(API(),None,PROJECT)
+    with pytest.raises(ValueError,match='destination'):
+        client.upload(source,'/etc/passwd',directory=False,deadline=time.monotonic()+10)
+
+
+def test_socket_timeout_closes_connection_without_retry():
+    calls=[]
+    class Connection:
+        def __init__(self,path,timeout):
+            calls.append(('connect',path))
+        def request(self,method,path,**kwargs):
+            calls.append((method,path))
+        def getresponse(self):
+            raise TimeoutError('inflight request uncertain')
+        def close(self):
+            calls.append(('close',None))
+    client=OwnedDockerIO(API(),Connection,PROJECT)
+    with pytest.raises(TimeoutError):
+        client.request('POST','/exec/'+EXEC+'/start',time.monotonic()+3,b'{}')
+    assert len([row for row in calls if row[0]=='POST'])==1 and calls[-1]==('close',None)
+
+
+def test_archive_transport_rejects_oversize_before_unbounded_allocation(monkeypatch,tmp_path):
+    from proteus.execution import docker_local_io
+    monkeypatch.setattr(docker_local_io,'MAX_ARCHIVE',1024)
+    source=tmp_path/'file';source.write_bytes(b'x'*2048)
+    with pytest.raises(ValueError,match='archive transport bound'):
+        archive(source,directory=False)
