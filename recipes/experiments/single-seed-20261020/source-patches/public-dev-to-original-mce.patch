index 0000000..185d2f3
--- /dev/null
+++ b/proteus/execution/docker_local_io.py
@@ -0,0 +1,152 @@
+"""Opt-in existing-owned-container I/O; no lifecycle/host execution fallback.
+
+Only the trusted Harbor code adapter calls this transport. Generated code never
+receives the socket/client. Upload and exec errors stay errors; cleanup deletes
+the exact owned container even when an exec request timed out ambiguously.
+"""
+from __future__ import annotations
+
+import io
+import json
+from pathlib import Path, PurePosixPath
+import re
+import shlex
+import struct
+import tarfile
+import time
+from urllib.parse import quote, urlencode
+
+MAX_OUTPUT = 8 * 1024**2
+MAX_ARCHIVE = 32 * 1024**2
+
+
+class LimitedArchive(io.BytesIO):
+    def write(self, data):
+        if self.tell()+len(data) > MAX_ARCHIVE:
+            raise ValueError('trusted upload exceeds archive transport bound')
+        return super().write(data)
+
+
+def archive(source, *, directory):
+    source = Path(source)
+    buffer = LimitedArchive()
+    def safe(info):
+        name = PurePosixPath(info.name)
+        if name.is_absolute() or '..' in name.parts or not (info.isfile() or info.isdir() or info.issym()):
+            raise ValueError('unsupported upload archive entry')
+        # Docker cp without -a copies as root in this rootful code sandbox.
+        # Preserve file/executable modes; never dereference host symlink data.
+        info.uid = info.gid = 0
+        info.uname = info.gname = ''
+        return info
+    with tarfile.open(fileobj=buffer, mode='w', dereference=False) as stream:
+        stream.add(source, arcname='.' if directory else source.name, recursive=directory, filter=safe)
+    return buffer.getvalue()
+
+
+def multiplexed_output(data):
+    """Compose's merged stderr=STDOUT preserves the engine frame order."""
+    output = bytearray()
+    while data:
+        if len(data) < 8:
+            raise ValueError('truncated Docker exec frame')
+        channel, padding, size = data[0], data[1:4], struct.unpack('>I', data[4:8])[0]
+        if channel not in (1, 2) or padding != b'\0\0\0' or size > MAX_OUTPUT or len(data) < 8+size:
+            raise ValueError('invalid or oversized Docker exec frame')
+        output.extend(data[8:8+size])
+        if len(output) > MAX_OUTPUT:
+            raise ValueError('Docker exec output exceeds transport bound')
+        data = data[8+size:]
+    return bytes(output)
+
+
+class OwnedDockerIO:
+    def __init__(self, api, connection_factory, project):
+        if re.fullmatch(r'proteus-[0-9a-f]{32}__env', project) is None:
+            raise ValueError('I/O requires the exact generated code project')
+        self.api, self.connection_factory, self.project = api, connection_factory, project
+
+    @staticmethod
+    def remaining(deadline):
+        value = deadline-time.monotonic()
+        if value <= 0:
+            raise TimeoutError('owned-container I/O deadline exceeded')
+        return value
+
+    def request(self, method, path, deadline, body=b'', content_type='application/json'):
+        connection = self.connection_factory(self.api.options['socket'], self.remaining(deadline))
+        try:
+            connection.request(method, '/v'+self.api.options['version']+path, body=body,
