+import json
+import subprocess
+from urllib.parse import parse_qs, urlsplit
+
+import pytest
+
+from proteus.execution import docker_local_api as api
+from proteus.execution import harbor_worker
+
+TRIAL = 'proteus-' + 'a' * 32
+PIN = {'socket': '/var/run/docker.sock', 'daemon_id': 'pinned-id', 'version': '1.41'}
+
+
+class CleanupAPI(api.LocalDockerAPI):
+    def __init__(self, *, changed=False, fail=False, leftover=False):
+        self.options = PIN
+        self.calls = []
+        self.deleted = False
+        self.changed, self.fail, self.leftover = changed, fail, leftover
+
+    def request(self, method, path, *, timeout, missing=False):
+        assert 0 < timeout <= 30
+        self.calls.append((method, path))
+        if self.fail:
+            raise TimeoutError('daemon unavailable')
+        if path.startswith('/containers/json?'):
+            filters = json.loads(parse_qs(urlsplit(path).query)['filters'][0])
+            project = filters['label'][0].split('=', 1)[1]
+            if project == TRIAL + '__env' and (not self.deleted or self.leftover):
+                return [{'Id': 'owned-id'}]
+            return []
+        if path.startswith('/networks?'):
+            return []
+        if path.startswith('/volumes?'):
+            return {'Volumes': None}
+        if method == 'GET' and path == '/containers/owned-id/json':
+            return {'Config': {'Labels': {'com.docker.compose.project':
+                    'unrelated' if self.changed else TRIAL+'__env'}}}
+        if method == 'DELETE' and path == '/containers/owned-id?force=1&v=1':
+            self.deleted = True
+            return None
+        raise AssertionError((method, path))
+
+
+def test_cleanup_rechecks_label_and_after_empty():
+    client = CleanupAPI()
+    result = client.cleanup(TRIAL, 180)
+    assert result['verified'] and len(result['resources']) == 6
+    assert client.calls.index(('GET', '/containers/owned-id/json')) < client.calls.index(
+        ('DELETE', '/containers/owned-id?force=1&v=1'))
+    assert sum(method == 'DELETE' for method, _ in client.calls) == 1
+
+
+def test_changed_label_never_deleted():
+    client = CleanupAPI(changed=True)
+    result = client.cleanup(TRIAL, 180)
+    assert not result['verified']
+    assert not any(method == 'DELETE' for method, _ in client.calls)
+
+
+@pytest.mark.parametrize('kwargs', [{'fail': True}, {'leftover': True}])
+def test_error_or_nonempty_after_is_not_verified(kwargs):
+    assert not CleanupAPI(**kwargs).cleanup(TRIAL, 180)['verified']
+
+
+def test_zero_cleanup_deadline_and_invalid_names_are_not_deleted():
+    client = CleanupAPI()
+    assert not client.cleanup(TRIAL, 0)['verified']
+    with pytest.raises(ValueError):
+        client.cleanup('other-project', 180)
+    assert not any(method == 'DELETE' for method, _ in client.calls)
+
+
+def test_daemon_identity_is_not_fabricated(monkeypatch):
+    monkeypatch.setattr(api.LocalDockerAPI, 'request', lambda *a, **kw: {'ID': 'wrong-id'})
+    with pytest.raises(ValueError, match='identity pin'):
+        api.LocalDockerAPI(PIN)
+
+
+@pytest.mark.parametrize('env,value', [('DOCKER_CONTEXT', 'remote'), ('DOCKER_HOST', 'tcp://example.invalid:2375')])
+def test_nondefault_context_never_uses_local_socket(monkeypatch, tmp_path, env, value):
+    monkeypatch.setenv('DOCKER_CONFIG', str(tmp_path))
+    monkeypatch.delenv('DOCKER_HOST', raising=False)
+    monkeypatch.delenv('DOCKER_CONTEXT', raising=False)
+    monkeypatch.setenv(env, value)
+    assert api.compatible_context(PIN) is False
+
+
+def test_stored_nondefault_context_retains_cli(monkeypatch, tmp_path):
+    monkeypatch.setenv('DOCKER_CONFIG', str(tmp_path))
+    monkeypatch.delenv('DOCKER_HOST', raising=False)
+    monkeypatch.delenv('DOCKER_CONTEXT', raising=False)
+    (tmp_path / 'config.json').write_text(json.dumps({'currentContext': 'remote'}))
+    assert api.compatible_context(PIN) is False
+
+
+def test_pin_validation_is_strict():
+    api.validate_options({})
+    for invalid in ({'socket': '/tmp/x'}, {**PIN, 'version': '1.99'}, {**PIN, 'socket': 'relative'}, {**PIN, 'extra': 'x'}):
+        with pytest.raises(ValueError):
+            api.validate_options(invalid)
+
+
+def test_command_metadata_equivalence_and_no_arbitrary_commands():
+    client = object.__new__(api.LocalDockerAPI)
+    client.options = PIN
+    calls = []
+    def request(method, path, **kw):
+        calls.append((method, path))
+        if path.startswith('/containers/json?'):
+            return [{'Id': '123456789012abcdef'}]
+        return {'Id': 'real-id', 'HostConfig': {'Memory': 536870912}}
+    client.request = request
+    assert json.loads(client.command(('inspect', 'real-id'), 10))[0]['Id'] == 'real-id'
+    assert json.loads(client.command(('image', 'inspect', 'python@sha256:abcd'), 10))[0]['Id'] == 'real-id'
+    assert '%2F' not in calls[1][1]  # digest has no slash; other separators remain encoded.
+    assert client.command(('ps', '--all', '--filter', 'label=com.docker.compose.project=own', '--format', '{{.ID}}'), 10) == '123456789012'
+    for command in (('rm', '--force', 'arbitrary'), ('ps', '--format', '{{.ID}}'), ('ps', '--all', '--filter', '--format', '{{.ID}}')):
+        assert client.command(command, 10) is NotImplemented
+    assert all(method == 'GET' for method, _ in calls)
+
+
+def test_missing_image_has_same_failure_semantics():
+    client = object.__new__(api.LocalDockerAPI)
+    client.request = lambda *a, **kw: None
+    with pytest.raises(subprocess.CalledProcessError, match='exit status 1') as error:
+        client.command(('image', 'inspect', 'absent'), 10)
+    assert error.value.stderr == 'No such image: absent'
+
+
+def test_failed_cleanup_identity_never_falls_back_to_cli(monkeypatch):
+    monkeypatch.setattr(harbor_worker, 'compatible_context', lambda pin: True)
+    def mismatch(*args, **kwargs):
+        raise ValueError('wrong daemon')
+    monkeypatch.setattr(harbor_worker, 'LocalDockerAPI', mismatch)
+    monkeypatch.setattr(harbor_worker, 'docker', lambda *a, **kw: pytest.fail('must not fall back'))
+    assert not harbor_worker.cleanup_owned_resources(TRIAL, local_docker_api=PIN)['verified']
+
+
+def test_worker_metadata_dispatches_only_recognized_calls(monkeypatch):
+    class Transport:
+        def command(self, args, timeout):
+            assert args == ('inspect', 'owned-id') and timeout == 17
+            return '  [{"Id":"owned-id"}]  '
+    monkeypatch.setattr(harbor_worker, '_LOCAL_API', Transport())
+    assert harbor_worker.docker('inspect', 'owned-id', timeout=17) == '[{"Id":"owned-id"}]'
+
+
+@pytest.mark.parametrize('status,data,error', [(500, b'secret daemon body', RuntimeError),
+                                             (200, b'x'*(8*1024*1024+1), ValueError)])
+def test_http_errors_and_oversize_are_bounded_and_closed(monkeypatch, status, data, error):
+    closed = []
+    class Response:
+        def read(self, maximum):
+            assert maximum == 8*1024*1024+1
+            return data
+    Response.status = status
+    class Connection:
+        def __init__(self, socket, timeout):
+            assert socket == PIN['socket'] and timeout == 3
+        def request(self, method, path):
+            assert method == 'GET' and path == '/v1.41/info'
+        def getresponse(self):
+            return Response()
+        def close(self):
+            closed.append(True)
+    monkeypatch.setattr(api, 'UnixConnection', Connection)
+    client = object.__new__(api.LocalDockerAPI)
+    client.options = PIN
+    with pytest.raises(error) as failure:
+        client.request('GET', '/info', timeout=3)
+    assert 'secret daemon body' not in str(failure.value) and closed == [True]
+
+
+def test_cleanup_configuration_is_bound_to_typed_backend_options():
+    from proteus.execution.harbor_code import HarborCodeOptions
+    options = HarborCodeOptions(python='/absolute/python', runtime_hash='sha256:'+'0'*64,
+                                local_docker_api=PIN)
+    assert HarborCodeOptions.from_json(options.to_json()).local_docker_api == PIN
