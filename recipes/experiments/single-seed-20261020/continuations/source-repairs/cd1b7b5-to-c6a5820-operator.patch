diff --git a/proteus_continuation/verified_prefix_decoder.py b/proteus_continuation/verified_prefix_decoder.py
new file mode 100644
index 0000000..bbc063b
--- /dev/null
+++ b/proteus_continuation/verified_prefix_decoder.py
@@ -0,0 +1,191 @@
+"""Isolated, bounded cache of verified ENCODED nodes in immutable parent DAGs.
+
+Not an executor and not installed into any running experiment. Native recovery
+still performs its complete envelope digest, typed restore, artifact/evidence,
+actor identity and request/body checks. Every node read, including cache hits,
+rechecks SHA256(raw)==address; unpack always builds fresh mutable containers.
+Only explicitly allowed CLOSED parent paths are eligible. Store replacement,
+metadata/WAL changes invalidate cached nodes, and mutation during decoding fails
+closed. Own/live successor stores use the original decoder, never this cache.
+"""
+from collections import OrderedDict
+from contextlib import contextmanager
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import threading
+import zlib
+
+
+@dataclass(frozen=True)
+class _Encoded:
+    raw: bytes
+    value: object  # private, read-only encoded tree; NEVER returned to callers
+
+
+class VerifiedPrefixDecoder:
+    def __init__(self, native, allowed_parents, *, max_nodes=32768, max_raw_bytes=32 * 1024 * 1024):
+        assert max_nodes > 0 and max_raw_bytes > 0
+        self.native = native
+        self.original_decode = native.decode
+        self.allowed = tuple(Path(p).absolute() for p in allowed_parents)
+        self.max_nodes, self.max_raw_bytes = max_nodes, max_raw_bytes
+        self._encoded = OrderedDict()
+        self._store_identity = {}
+        self._raw_bytes = 0
+        self._lock = threading.RLock()
+        self.counts = {'hits': 0, 'misses': 0, 'raw_sha_checks': 0, 'invalidated_nodes': 0,
+                       'source_sql_reads': 0, 'fallback_decodes': 0,
+                       'miss_raw_encoded_bytes': 0}
+
+    def _fail(self, message):
+        from proteus.core.serialization import ContractError
+        raise ContractError(message)
+
+    @staticmethod
+    def _stat(path):
+        if not path.exists():
+            return None
+        info = path.stat()
+        return (info.st_dev, info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+    def _fingerprint(self, root):
+        path = root / 'snapshot-nodes.sqlite3'
+        if path.is_symlink() or (root.exists() and root.is_symlink()):
+            self._fail('snapshot store must not be a symlink')
+        if not path.is_file():
+            self._fail('snapshot node store is missing')
+        return (str(path), self._stat(path), self._stat(path.with_name(path.name + '-wal')),
+                self._stat(path.with_name(path.name + '-shm')))
+
+    def _invalidate_if_changed(self, identity):
+        path = identity[0]
+        with self._lock:
+            old = self._store_identity.get(path)
+            if old is not None and old != identity:
+                for key in list(self._encoded):
+                    if key[0][0] == path:
+                        entry = self._encoded.pop(key)
+                        self._raw_bytes -= len(entry.raw)
+                        self.counts['invalidated_nodes'] += 1
+            self._store_identity[path] = identity
+
+    def _node(self, db, identity, digest):
+        key = (identity, digest)
+        with self._lock:
+            entry = self._encoded.get(key)
+            if entry is not None:
+                self._encoded.move_to_end(key)
+                self.counts['hits'] += 1
+        if entry is None:
+            with self._lock:
+                self.counts['source_sql_reads'] += 1
+                self.counts['misses'] += 1
+            row = db.execute('SELECT data FROM nodes WHERE hash=?', (digest,)).fetchone()
+            if row is None:
+                self._fail('snapshot node is missing')
+            try:
+                raw = zlib.decompress(row[0])
+                if hashlib.sha256(raw).hexdigest() != digest:
+                    self._fail('snapshot node integrity mismatch')
+                entry = _Encoded(raw, json.loads(raw))
+            except (zlib.error, ValueError) as exc:
+                from proteus.core.serialization import ContractError
+                raise ContractError('invalid compressed snapshot node') from exc
+            with self._lock:
+                self.counts['miss_raw_encoded_bytes'] += len(entry.raw)
+                # Concurrent readers may have inserted the same immutable node.
+                existing = self._encoded.get(key)
+                if existing is not None:
+                    entry = existing
+                elif len(entry.raw) <= self.max_raw_bytes:
+                    self._encoded[key] = entry
+                    self._raw_bytes += len(entry.raw)
+                    while len(self._encoded) > self.max_nodes or self._raw_bytes > self.max_raw_bytes:
+                        _, evicted = self._encoded.popitem(last=False)
+                        self._raw_bytes -= len(evicted.raw)
+        # Keep the native per-reference digest check even for cached nodes.
+        if hashlib.sha256(entry.raw).hexdigest() != digest:
+            self._fail('cached snapshot node integrity mismatch')
+        with self._lock:
+            self.counts['raw_sha_checks'] += 1
+        return entry.value
+
+    def __call__(self, root, encoded):
+        root = Path(root).absolute()
+        if not any(root.is_relative_to(parent) for parent in self.allowed):
+            with self._lock:
+                self.counts['fallback_decodes'] += 1
+            return self.original_decode(root, encoded)
+        identity = self._fingerprint(root)
+        self._invalidate_if_changed(identity)
+        active = set()
+        local = {}  # Native decoder also resolves each digest once per call.
+        # Original RO connection contract; no Ledger or writable DB is opened.
+        with self.native._connect(root, readonly=True) as db:
+            def unpack(value, depth=0):
+                if depth > 256:
+                    self._fail('snapshot node nesting limit exceeded')
+                if not isinstance(value, list):
+                    if type(value) not in (str, int, float, bool, type(None)):
+                        self._fail('invalid inline snapshot node')
+                    if type(value) is float and not math.isfinite(value):
+                        self._fail('nonfinite snapshot value')
+                    return value
+                if len(value) != 2 or value[0] not in ('@', 'd', 'l', 'a', 's'):
+                    self._fail('invalid snapshot node encoding')
+                kind, payload = value
+                if kind == '@':
+                    if type(payload) is not str or not re.fullmatch(r'[0-9a-f]{64}', payload) or payload in active:
+                        self._fail('invalid or cyclic snapshot reference')
+                    if payload not in local:
+                        local[payload] = self._node(db, identity, payload)
+                    node = local[payload]
+                    active.add(payload)
+                    try:
+                        return unpack(node, depth + 1)
+                    finally:
+                        active.remove(payload)
+                if kind == 's':
+                    if type(payload) is not str:
+                        self._fail('invalid snapshot string')
+                    return payload
+                if kind == 'd':
+                    if not isinstance(payload, list):
+                        self._fail('invalid snapshot dictionary')
+                    result = {}
+                    for pair in payload:
+                        if not isinstance(pair, list) or len(pair) != 2 or type(pair[0]) is not str or pair[0] in result:
+                            self._fail('invalid snapshot dictionary entry')
+                        result[pair[0]] = unpack(pair[1], depth + 1)
+                    return result
+                if not isinstance(payload, list):
+                    self._fail('invalid snapshot sequence')
+                items = [unpack(item, depth + 1) for item in payload]
+                if kind == 'l':
+                    return items
+                if not all(isinstance(item, list) for item in items):
+                    self._fail('invalid snapshot page')
+                return [item for page in items for item in page]
+            result = unpack(encoded)
+        if self._fingerprint(root) != identity:
+            self._invalidate_if_changed(self._fingerprint(root))
+            self._fail('immutable prefix snapshot store changed during decode')
+        return result
+
+    @contextmanager
+    def installed(self):
+        assert self.native.decode is self.original_decode, 'another decoder override is active'
+        self.native.decode = self
+        try:
+            yield self
+        finally:
+            self.native.decode = self.original_decode
+
+    def statistics(self):
+        with self._lock:
+            return {**self.counts, 'cached_nodes': len(self._encoded), 'cached_raw_bytes': self._raw_bytes,
+                    'max_nodes': self.max_nodes, 'max_raw_bytes': self.max_raw_bytes}
