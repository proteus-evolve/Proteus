diff --git a/proteus_continuation/exact_json_snapshot_reader.py b/proteus_continuation/exact_json_snapshot_reader.py
new file mode 100644
index 0000000..b6f93a4
--- /dev/null
+++ b/proteus_continuation/exact_json_snapshot_reader.py
@@ -0,0 +1,64 @@
+"""Exact native recovery reader, with a STRICT PURE-JSON digest fast path.
+
+This is not a global content_hash/Contract shortcut. Only JSON containers just
+read from recovery envelopes/DAGs enter this path. Keys, exact scalar/container
+types, finite numbers and circular structures are validated before using the
+same native canonical JSON bytes. Whole-envelope SHA256 remains mandatory.
+"""
+import hashlib
+import json
+import math
+
+from proteus.artifacts.store import _read
+from proteus.core import snapshot_store
+from proteus.core.serialization import ContractError, read_json
+from proteus.core.contracts import require
+
+
+def canonical_plain_json_bytes(value):
+    active = set()
+
+    def validate(item):
+        kind = type(item)
+        if kind in (str, bool, int, type(None)):
+            return
+        if kind is float:
+            if not math.isfinite(item):
+                raise ContractError('not a finite JSON value')
+            return
+        if kind not in (dict, list):
+            raise ContractError('plain recovery JSON only; no typed Contract shortcut')
+        identity = id(item)
+        if identity in active:
+            raise ContractError('circular plain recovery JSON')
+        active.add(identity)
+        try:
+            if kind is dict:
+                for key, child in item.items():
+                    if type(key) is not str:
+                        raise ContractError('JSON object keys must be strings')
+                    validate(child)
+            else:
+                for child in item:
+                    validate(child)
+        finally:
+            active.remove(identity)
+    validate(value)
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'),
+                      allow_nan=False).encode('utf-8')
+
+
+def plain_json_digest(value):
+    return 'sha256:' + hashlib.sha256(canonical_plain_json_bytes(value)).hexdigest()
+
+
+def load(path):
+    envelope = read_json(_read(path).decode())
+    if set(envelope) == {'hash', 'value', 'storage'}:
+        require(envelope['storage'] == snapshot_store.FORMAT, 'unknown recovery snapshot storage format')
+        require(isinstance(envelope['value'], dict) and 'snapshot' in envelope['value'], 'missing stored snapshot')
+        envelope['value']['snapshot'] = snapshot_store.decode(snapshot_store.directory(path), envelope['value']['snapshot'])
+        del envelope['storage']
+    require(set(envelope) == {'hash', 'value'} and plain_json_digest(envelope['value']) == envelope['hash'],
+            'recovery record integrity mismatch')
+    return envelope['value']
