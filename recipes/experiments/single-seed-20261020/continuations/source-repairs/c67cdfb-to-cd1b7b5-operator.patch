diff --git a/proteus_continuation/inspect_owned.py b/proteus_continuation/inspect_owned.py
new file mode 100644
index 0000000..9c93935
--- /dev/null
+++ b/proteus_continuation/inspect_owned.py
@@ -0,0 +1,82 @@
+"""Read-only owned checkpoint + cached timing replay, NEVER method/actor run.
+
+Does not acquire/change the parent claim or activate an executor upgrade.
+Asserts ledger, manifest, launch intent, owned journal and execution bytes stay
+unchanged. Receipt is published outside the scientific branch.
+"""
+import json,subprocess,time
+from pathlib import Path
+from proteus_continuation.cli import ROOT,sha,once,setup
+
+def inspect(args):
+    path=Path(args.plan).resolve();plan=json.loads(path.read_text());root=Path(plan['physical_branch_root'])
+    assert path==root/'branch-manifest.json' and sha(path.read_bytes())==args.expected_manifest_sha256
+    out=Path(args.out).resolve();assert out.is_relative_to(ROOT) and not out.is_relative_to(root)
+    assert (root/'launch-intent.json').is_file() and not out.exists()
+    operator=Path(__file__).resolve().parents[1]
+    pin=subprocess.check_output(['git','-C',str(operator),'rev-parse','HEAD'],text=True).strip()
+    assert not subprocess.check_output(['git','-C',str(operator),'status','--porcelain'],text=True)
+    _,manifest,registry,_=setup(plan['independent_expectations']['path'],plan['parent_label'])
+    from proteus.core.methods import RunServices
+    from proteus.core.serialization import content_hash
+    from proteus.core.workflows import WorkflowMap
+    from proteus_continuation.journal import PrefixJournal,original_load
+    from proteus_continuation.runtime import Context,operational_overlay
+    from proteus_continuation.upgrade import boundary_files,owned_actors
+    before=boundary_files(root);actors_before=owned_actors(root)
+    parent=Path(plan['parent_run'])
+    parent_before={name:sha((parent/name).read_bytes()) for name in plan['protected_parent_files']}
+    assert parent_before==plan['protected_parent_files']
+    protected=[path,root/'readonly-prefix-refs.json',*sorted((root/'private/recovery/operations').glob('*.json'))]
+    original={str(p):sha(p.read_bytes()) for p in protected}
+    context=Context(plan,root,registry,None,allow_paid=False)
+    context.read_refs=json.loads((root/'readonly-prefix-refs.json').read_text())
+    definition=registry.get(manifest.recipe.method.plugin)
+    def validate(state):
+        if state:definition.state_schema.from_dict(state.state.payload)
+    with operational_overlay(context):
+        services=RunServices(run_id=manifest.run_id,recipe=manifest.recipe,registry=registry,
+            root=root,resume=True,lock_hash=manifest.lock_hash)
+        journal=PrefixJournal(services,manifest_hash=manifest.manifest_hash,validate_state=validate);services._journal=journal
+        state,final=journal.initialize();assert final is None
+        checkpoint=journal.cursor;replayed=[]
+        # Only replay already sealed timing.begin. This does not call its fresh
+        # create() closure; do not invoke method.run(), workflow.run(), or actors.
+        next_path=journal._path(journal.cursor+1,'request')
+        request=original_load(next_path)
+        if request['kind']=='timing.begin':
+            assert journal._path(journal.cursor+1,'result').is_file()
+            ref=services.begin_timing(request['identity']['operation_id'])
+            replayed.append({'kind':'timing.begin','sequence':journal.cursor,'original_ref':ref.to_dict()})
+        pending_path=journal._path(journal.cursor+1,'request');pending=original_load(pending_path)
+        assert pending['kind']=='workflow.map' and journal.pending
+        identity=pending['identity'];new_scopes=[]
+        for job in identity['jobs']:
+            child=WorkflowMap.child_id(identity['operation_id'],job['key'])
+            relative=Path('private/workflows')/content_hash(identity['operation_id']).split(':')[1]/child/'journal'
+            old=Path(plan['parent_run'])/relative
+            declared=[r for r in context.read_refs.values() if Path(r['parent']).is_relative_to(old)]
+            new_scopes.append({'child_id':child,'inherited_scope_path':str(old),
+                'inherited_directory_exists':old.exists(),'inherited_origin_exists':(old/'origin.json').exists(),
+                'declared_inherited_refs':len(declared),'genuinely_new':not old.exists() and not old.is_symlink() and not declared})
+        report={'schema':'proteus.continuation.owned-checkpoint-readonly-inspection.v1','UTC_epoch':time.time(),
+            'inspection_operator_revision':pin,'inspection_operator_repository':'local-unpublished:'+str(operator),
+            'initial_operator_revision':plan['executor_operator_source']['revision'],
+            'branch_manifest_sha256':sha(path.read_bytes()),'physical_branch_root':str(root),
+            'checkpoint_cursor':checkpoint,'sampling_cursor':state.sampling_cursor,
+            'method_cursor':state.state.payload.get('cursor'),'method_state_hash':content_hash(state),
+            'framework_rng_hash':sha(repr(services.rng.getstate()).encode()),
+            'total_sealed_actor_records_in_owned_snapshot':len(services.actor_calls),
+            'owned_actor_boundary':actors_before,'stopped_boundary_hashes':before,
+            'cached_operations_only_replayed':replayed,'pending_sequence':journal.cursor+1,
+            'pending_request_sha256':sha(pending_path.read_bytes()),'journal_pending':journal.pending,
+            'new_workflow_scopes':new_scopes,
+            'provider_dispatch_enabled':False,'method_or_workflow_or_actor_run_invocations':0,
+            'no_runtime_upgrade_activated':True,'no_parent_claim_mutation':True}
+    assert boundary_files(root)==before and owned_actors(root)==actors_before
+    assert {name:sha((parent/name).read_bytes()) for name in parent_before}==parent_before
+    assert {str(p):sha(p.read_bytes()) for p in protected}==original
+    report['all_protected_bytes_unchanged']=True
+    once(out,report)
+    print(json.dumps({'receipt':str(out),'sha256':sha(out.read_bytes()),'checkpoint':checkpoint,
+        'cursor':report['method_cursor'],'owned_closed_actors':actors_before['count'],'model_calls':0}))
diff --git a/proteus_continuation/journal.py b/proteus_continuation/journal.py
index 4b1092e..b2cab86 100644
--- a/proteus_continuation/journal.py
+++ b/proteus_continuation/journal.py
@@ -25,6 +25,17 @@ class PrefixJournal(OriginalJournal):
         if context is None:return super().initialize()
         parent,cut=context.journal_parent(self.root)
         origin=parent/'origin.json'
+        if not origin.exists():
+            # A new post-recovery workflow has NO old scope to inherit. Use the
+            # unchanged native fresh/own-journal initialization. A missing ROOT
+            # parent is still fatal; only new child scopes take this path.
+            require(self.root!=self.services.root/'private/recovery','root inherited journal origin missing')
+            require(not parent.exists() and not parent.is_symlink(),
+                'declared inherited journal scope exists but its origin is missing')
+            require(not any(Path(ref['parent']).is_relative_to(parent)
+                for ref in getattr(context,'read_refs',{}).values()),
+                'declared inherited journal references exist without origin')
+            return super().initialize()
         require(origin.is_file(),'inherited journal origin missing')
         record=original_load(origin)
         require(record['identity']==self.identity,'inherited journal identity differs')
diff --git a/proteus_continuation/upgrade.py b/proteus_continuation/upgrade.py
new file mode 100644
index 0000000..944583b
--- /dev/null
+++ b/proteus_continuation/upgrade.py
@@ -0,0 +1,76 @@
+"""Explicit root-authorized operational executor upgrade; SAME science branch.
+
+Initial manifest, initial launch intent, old source, old invocation and ledger
+are never replaced. A separate authorization pins old->new provenance and the
+exact owned stopped boundary. This is not native same-runtime resume.
+"""
+import json,re,sqlite3
+from pathlib import Path
+from proteus_continuation.cli import ROOT,sha,once
+
+def boundary_files(root):
+    return {name:sha((root/name).read_bytes()) for name in (
+        'private/ledger.sqlite3','execution-0001.json','launch-intent.json',
+        'invocations/0001.receipt.json','private/recovery/operations/00000804.request.json',
+        'private/recovery/operations/00000804.result.json','private/recovery/operations/00000806.request.json')}
+
+def owned_actors(root):
+    db=sqlite3.connect((root/'private/ledger.sqlite3').resolve().as_uri()+'?mode=ro',uri=True,timeout=3)
+    try:
+        db.execute('PRAGMA query_only=ON')
+        rows=db.execute("SELECT id,identity_json,state,settlement_json FROM entries WHERE json_extract(identity_json,'$.metadata.kind')='actor' ORDER BY id").fetchall()
+        active=db.execute("SELECT count(*) FROM entries WHERE state IN ('reserved','started')").fetchone()[0]
+    finally:db.close()
+    values={i:{'identity':json.loads(identity),'state':state,'settlement':json.loads(result) if result else None}
+        for i,identity,state,result in rows}
+    from proteus.core.serialization import content_hash
+    return {'count':len(values),'all_completed':all(r['state']=='completed' for r in values.values()),
+        'records_hash':content_hash(values),'unsettled_rows':active}
+
+def validate_upgrade(plan,plan_path,release_path,authorization_path,operator,pin):
+    root=Path(plan['physical_branch_root']).resolve();path=Path(authorization_path).resolve()
+    assert path.parent==ROOT/'root-acceptances','only independent root authorizes an executor change'
+    document=json.loads(path.read_text());digest=sha(path.read_bytes())
+    assert document['schema']=='proteus.continuation.root-executor-upgrade.v1' and document['accepted'] is True
+    assert document['authorized_entrypoint']=='same-branch-resume'
+    assert document['upgrade_sequence']==1,'only this explicit first operational upgrade is implemented'
+    assert document['physical_branch_root']==str(root)
+    assert document['branch_manifest_sha256']==sha(Path(plan_path).read_bytes())
+    assert document['parent_manifest_sha256']==plan['parent_manifest_sha256']
+    assert document['old_executor_revision']==plan['executor_operator_source']['revision']
+    assert document['new_executor_revision']==pin and pin!=document['old_executor_revision']
+    assert document['new_executor_repository']=='local-unpublished:'+str(operator)
+    assert document['initial_root_release_sha256']==sha(Path(release_path).read_bytes())
+    assert document['original_launch_intent_sha256']==sha((root/'launch-intent.json').read_bytes())
+    assert document['parent_label']==plan['parent_label']=='linux-combee-formula-offline-combee_dynamic-v6-ledger-io'
+    receipt=json.loads((root/'invocations/0001.receipt.json').read_text())
+    assert receipt['operator_revision']==document['old_executor_revision']
+    assert receipt['branch_manifest_sha256']==document['branch_manifest_sha256']
+    assert receipt['status']=='deferred' and receipt['journal_pending'] is True and receipt['method_result'] is None
+    assert receipt['diagnostic']=='workflow did not commit: ContractError: inherited journal origin missing'
+    assert document['protected_stopped_boundary']['invocations/0001.receipt.json']==sha((root/'invocations/0001.receipt.json').read_bytes())
+    activation=root/'operational-upgrades/0001.activation.json'
+    if activation.exists():
+        old=json.loads(activation.read_text())
+        assert old['root_authorization_sha256']==digest and old['new_executor_revision']==pin
+        assert old['protected_stopped_boundary']==document['protected_stopped_boundary']
+    else:
+        assert boundary_files(root)==document['protected_stopped_boundary'],'owned boundary changed before upgrade'
+        actors=owned_actors(root)
+        assert actors==document['owned_actors_at_authorization']
+        assert actors['count']==6 and actors['all_completed'] and actors['unsettled_rows']==0
+    return {'document':document,'path':str(path),'sha256':digest,'activation':str(activation)}
+
+def activate_upgrade(binding,*,lease,pin):
+    lease.require_owned();path=Path(binding['activation']);document=binding['document']
+    if path.exists():
+        assert json.loads(path.read_text())['root_authorization_sha256']==binding['sha256'];return
+    root=Path(document['physical_branch_root'])
+    assert boundary_files(root)==document['protected_stopped_boundary']
+    assert owned_actors(root)==document['owned_actors_at_authorization']
+    once(path,{'schema':'proteus.continuation.executor-upgrade-activation.v1',
+        'root_authorization_path':binding['path'],'root_authorization_sha256':binding['sha256'],
+        'old_executor_revision':document['old_executor_revision'],'new_executor_revision':pin,
+        'protected_stopped_boundary':document['protected_stopped_boundary'],
+        'initial_manifest_and_launch_intent_untouched':True,
+        'same_physical_branch_ledger_claim_and_stable_IDs':True})
