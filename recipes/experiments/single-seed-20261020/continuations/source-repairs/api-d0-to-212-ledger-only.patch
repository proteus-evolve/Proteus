+# All Ledger instances using the same canonical file share this in-process I/O
+# queue. Keep SQLite's independent process locking/timeout and fresh connections.
+# Readers must participate too: a long read cursor in rollback-journal mode can
+# otherwise block a writer's COMMIT until SQLite's busy timeout expires.
+_CONNECTION_LOCKS = WeakValueDictionary()
+_CONNECTION_LOCKS_GUARD = threading.Lock()
+
+
+def _connection_lock(path):
+    key = str(path.resolve())
+    with _CONNECTION_LOCKS_GUARD:
+        lock = _CONNECTION_LOCKS.get(key)
+        if lock is None:
+            lock = threading.RLock()
+            _CONNECTION_LOCKS[key] = lock
+        return lock
+
+
+def _after_fork_child():
+    # No inherited thread can release a mutex owned by a vanished parent thread.
+    # New child connections still contend through SQLite with other processes.
+    global _CONNECTION_LOCKS, _CONNECTION_LOCKS_GUARD
+    _CONNECTION_LOCKS = WeakValueDictionary()
+    _CONNECTION_LOCKS_GUARD = threading.Lock()
+
+
+if hasattr(os, "register_at_fork"):
+    os.register_at_fork(after_in_child=_after_fork_child)
+
