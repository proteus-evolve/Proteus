diff --git a/experiments/runner/controller_model.py b/experiments/runner/controller_model.py
new file mode 100644
index 0000000..8bac606
--- /dev/null
+++ b/experiments/runner/controller_model.py
@@ -0,0 +1,136 @@
+"""Keyless Aki LLM implementation backed by a local controller Unix socket."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import socket
+import uuid
+from pathlib import Path
+from typing import Any
+
+from aki.models.base import ModelConfig, ModelResponse
+from aki.models.types.llm import LLMInterface
+
+PROTOCOL_VERSION = 1
+_MAX_FRAME_BYTES = 32 * 1024 * 1024
+
+
+def _receive_exact(connection: socket.socket, size: int) -> bytes:
+    chunks: list[bytes] = []
+    while size:
+        chunk = connection.recv(size)
+        if not chunk:
+            raise EOFError("controller closed an incomplete frame")
+        chunks.append(chunk)
+        size -= len(chunk)
+    return b"".join(chunks)
+
+
+def _receive_frame(connection: socket.socket) -> dict[str, object]:
+    size = int.from_bytes(_receive_exact(connection, 8), "big")
+    if size <= 0 or size > _MAX_FRAME_BYTES:
+        raise ValueError(f"invalid controller frame size {size}")
+    value = json.loads(_receive_exact(connection, size))
+    if not isinstance(value, dict):
+        raise TypeError("controller frame must contain a JSON object")
+    version = value.get("protocol_version")
+    if type(version) is not int or version != PROTOCOL_VERSION:
+        raise ValueError("controller frame has the wrong protocol version")
+    return value
+
+
+def _send_frame(connection: socket.socket, value: dict[str, object]) -> None:
+    payload = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode()
+    if len(payload) > _MAX_FRAME_BYTES:
+        raise ValueError("controller request exceeds the frame limit")
+    connection.sendall(len(payload).to_bytes(8, "big") + payload)
+
+
+class ControllerLLM(LLMInterface):
+    """Current Aki LLM interface transported to the trusted local controller."""
+
+    def __init__(self, *, model: str, socket_path: str | Path) -> None:
+        super().__init__(
+            ModelConfig(
+                provider="proteus-controller",
+                model_name=model,
+                api_key=None,
+                base_url=None,
+            )
+        )
+        self.socket_path = str(socket_path)
+        self._connection: socket.socket | None = None
+
+    def _connect(self) -> socket.socket:
+        if self._connection is None:
+            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            try:
+                connection.connect(self.socket_path)
+            except OSError:
+                connection.close()
+                raise
+            self._connection = connection
+        return self._connection
+
+    def _chat(
+        self,
+        *,
+        messages: list[dict[str, Any]],
+        tools: list[dict[str, Any]] | None,
+        temperature: float,
+        max_tokens: int | None,
+        kwargs: dict[str, Any],
+    ) -> ModelResponse:
+        request_id = uuid.uuid4().hex
+        request: dict[str, object] = {
+            "protocol_version": PROTOCOL_VERSION,
+            "request_id": request_id,
+            "kind": "model_request",
+            "payload": {
+                "model": self.model_name,
+                "messages": messages,
+                "tools": tools or [],
+                "temperature": temperature,
+                "max_tokens": max_tokens,
+                "kwargs": kwargs,
+            },
+        }
+        connection = self._connect()
+        _send_frame(connection, request)
+        response = _receive_frame(connection)
+        if response.get("protocol_version") != PROTOCOL_VERSION:
+            raise ValueError("controller response has the wrong protocol version")
+        if response.get("request_id") != request_id:
+            raise ValueError("controller response has the wrong request id")
+        if response.get("kind") != "model_response":
+            raise ValueError("controller response has the wrong message kind")
+        payload = response.get("payload")
+        if not isinstance(payload, dict):
+            raise TypeError("controller response payload must be an object")
+        model_response = ModelResponse.model_validate(payload)
+        if model_response.model != self.model_name:
+            raise ValueError("controller response model does not match the requested model")
+        return model_response
+
+    async def chat(
+        self,
+        messages: list[dict[str, Any]],
+        tools: list[dict[str, Any]] | None = None,
+        temperature: float = 0.7,
+        max_tokens: int | None = None,
+        **kwargs: Any,
+    ) -> ModelResponse:
+        return await asyncio.to_thread(
+            self._chat,
+            messages=messages,
+            tools=tools,
+            temperature=temperature,
+            max_tokens=max_tokens,
+            kwargs=kwargs,
+        )
+
+    async def close(self) -> None:
+        if self._connection is not None:
+            self._connection.close()
+            self._connection = None
